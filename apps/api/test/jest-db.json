{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".db-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/bullmq|@nestjs/bull-shared|bullmq|msgpackr)/)"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000
}
