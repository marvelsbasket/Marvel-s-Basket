// ==============================================================================
// MARVEL'S BASKET — PRISMA DATABASE SCHEMA
// Phase 03: Complete Marketplace Relational Domain Baseline
// PostgreSQL 16 + Prisma ORM 5.x
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. SYSTEM BASELINE & HEALTH
// ==============================================================================

model SystemHealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  service   String   @default("marvels-basket-api")
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("system_health_checks")
}

// ==============================================================================
// 2. ENUMS
// ==============================================================================

enum UserRoleType {
  CUSTOMER
  SELLER
  DELIVERY_PARTNER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

enum VerificationStatus {
  PENDING
  PENDING_REVIEW
  VERIFIED
  REJECTED
  NEEDS_RESUBMISSION
}

enum SellerStatus {
  DRAFT
  PENDING_VERIFICATION
  UNDER_REVIEW
  APPROVED_ACTIVE
  APPROVED
  PENDING
  REJECTED
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  DISCONTINUED
}

enum FoodPreference {
  VEG
  NON_VEG
  VEGAN
  NA
}

enum SellerProductStatus {
  PENDING
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  REJECTED
  PAUSED
  DISABLED
}

enum InventoryTransactionType {
  INITIAL_STOCK
  RESTOCK
  MANUAL_INCREASE
  MANUAL_DECREASE
  DAMAGED_STOCK_WRITEOFF
  EXPIRED_STOCK_WRITEOFF
  PICKER_SHORTAGE_WRITEOFF
  ORDER_COMMITTED
  RESERVATION_HOLD
  RESERVATION_RELEASE
  INVENTORY_CORRECTION
  STOCK_IN
  STOCK_OUT
  ORDER_FULFILLMENT
  ADJUSTMENT
}

enum StockReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum CheckoutSessionStatus {
  PREPARED
  RESERVATION_ACTIVE
  EXPIRED
  RELEASED
  COMMITTED
  CANCELLED
}

enum OrderComplaintCategory {
  MISSING_ITEM
  WRONG_ITEM
  DAMAGED_ITEM
  SPOILED_PERISHABLE
  INCORRECT_QUANTITY
  OTHER
}

enum OrderComplaintStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
  FAILED
  RETURN_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  AUTHORIZED
  CAPTURED
  SUCCESS
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  COMPLETED
  FAILED
  REJECTED
}

enum CommissionType {
  PERCENTAGE
  FLAT
}

enum LedgerEntryType {
  ORDER_CREDIT
  COMMISSION_DEBIT
  REFUND_DEBIT
  SETTLEMENT_PAYOUT
  ADJUSTMENT
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ON_HOLD
}

enum DeliveryStatus {
  PENDING
  READY_FOR_PICKUP
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryAssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  REFUND
  PROMOTION
  ACCOUNT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

// ==============================================================================
// 3. IDENTITY & ACCESS MANAGEMENT (IAM)
// ==============================================================================

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  // Relationships
  userRoles               UserRole[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  customerProfile         CustomerProfile?
  addresses               CustomerAddress[]
  seller                  Seller?                  @relation("UserToSeller")
  deliveryPartner         DeliveryPartner?
  cart                    Cart?
  checkoutSessions        CheckoutSession[]        @relation("CustomerCheckoutSessions")
  orders                  Order[]                  @relation("CustomerOrders")
  orderComplaints         OrderComplaint[]         @relation("CustomerOrderComplaints")
  reviews                 Review[]
  wishlist                Wishlist?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  couponUsages            CouponUsage[]
  auditLogs               AuditLog[]               @relation("ActorAuditLogs")
  adminActivityLogs       AdminActivityLog[]       @relation("AdminLogs")
  documentReviews         SellerDocumentReview[]   @relation("DocumentReviewer")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  roleType    UserRoleType? @map("role_type")
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  tokenFamilyId    String?   @map("token_family_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  tokenHash String                @map("token_hash")
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
  @@map("verification_tokens")
}

// ==============================================================================
// 4. CUSTOMER PROFILE & ADDRESSES
// ==============================================================================

model CustomerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  dateOfBirth DateTime? @map("date_of_birth")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model CustomerAddress {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  addressType    AddressType @default(HOME) @map("address_type")
  label          String      @default("Home")
  recipientName  String      @map("recipient_name")
  phone          String
  forSomeoneElse Boolean     @default(false) @map("for_someone_else")
  addressLine1   String      @map("address_line1")
  addressLine2   String?     @map("address_line2")
  landmark       String?
  locality       String?
  city           String
  state          String
  postalCode     String      @map("postal_code")
  country        String      @default("India")
  latitude       Decimal?    @db.Decimal(10, 8)
  longitude      Decimal?    @db.Decimal(11, 8)
  isDefault      Boolean     @default(false) @map("is_default")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSessions CheckoutSession[]

  @@index([userId])
  @@index([postalCode])
  @@map("customer_addresses")
}

// ==============================================================================
// 5. SELLER & STORE DOMAIN
// ==============================================================================

model Seller {
  id               String       @id @default(uuid()) @db.Uuid
  ownerUserId      String       @unique @map("owner_user_id") @db.Uuid
  businessName     String       @map("business_name")
  slug             String       @unique
  businessEmail    String       @map("business_email")
  businessPhone    String       @map("business_phone")
  gstin            String?
  pan              String?
  status           SellerStatus @default(DRAFT)
  approvalDate     DateTime?    @map("approval_date")
  rejectionReason  String?      @map("rejection_reason")
  suspensionReason String?      @map("suspension_reason")

  // Phase 07: Seller Onboarding & Business/Store Details
  storeDisplayName        String?   @map("store_display_name")
  storeCategory           String?   @map("store_category")
  legalBusinessName       String?   @map("legal_business_name")
  businessEntityType      String?   @map("business_entity_type")
  fssaiNumber             String?   @map("fssai_number")
  fssaiExpiryDate         DateTime? @map("fssai_expiry_date")
  shopEstablishmentNumber String?   @map("shop_establishment_number")

  // Encrypted bank details at rest & masked representation
  bankAccountHolderName      String? @map("bank_account_holder_name")
  bankAccountNumberEncrypted String? @map("bank_account_number_encrypted")
  bankAccountNumberMasked    String? @map("bank_account_number_masked")
  bankIfscCode               String? @map("bank_ifsc_code")
  bankName                   String? @map("bank_name")
  bankAccountType            String? @map("bank_account_type")
  upiId                      String? @map("upi_id")

  // Onboarding wizard progress & lifecycle tracking
  currentStep Int       @default(1) @map("current_step")
  isSubmitted Boolean   @default(false) @map("is_submitted")
  submittedAt DateTime? @map("submitted_at")
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relationships
  owner             User                  @relation("UserToSeller", fields: [ownerUserId], references: [id], onDelete: Restrict)
  profile           SellerProfile?
  documents         SellerDocument[]
  businessHours     SellerBusinessHours[]
  serviceAreas      SellerServiceArea[]
  listings          SellerProduct[]
  orders            Order[]               @relation("SellerOrders")
  carts             Cart[]                @relation("SellerCarts")
  checkoutSessions  CheckoutSession[]     @relation("SellerCheckoutSessions")
  commissionRecords CommissionRecord[]
  ledgerEntries     SellerLedgerEntry[]
  settlements       Settlement[]
  commissionRules   CommissionRule[]
  statusHistory     SellerStatusHistory[]

  @@index([status])
  @@index([slug])
  @@map("sellers")
}

model SellerProfile {
  id                         String   @id @default(uuid()) @db.Uuid
  sellerId                   String   @unique @map("seller_id") @db.Uuid
  logoUrl                    String?  @map("logo_url")
  bannerUrl                  String?  @map("banner_url")
  description                String?
  addressLine1               String   @map("address_line1")
  addressLine2               String?  @map("address_line2")
  landmark                   String?
  city                       String
  state                      String
  postalCode                 String   @map("postal_code")
  country                    String   @default("India")
  latitude                   Decimal? @db.Decimal(10, 8)
  longitude                  Decimal? @db.Decimal(11, 8)
  serviceRadiusKm            Decimal? @map("service_radius_km") @db.Decimal(5, 2)
  openingTime                String?  @map("opening_time")
  closingTime                String?  @map("closing_time")
  weeklyOffDays              String?  @map("weekly_off_days")
  storefrontPhotoUrl         String?  @map("storefront_photo_url")
  storefrontPhotoPublicId    String?  @map("storefront_photo_public_id")
  storeInteriorPhotoUrl      String?  @map("store_interior_photo_url")
  storeInteriorPhotoPublicId String?  @map("store_interior_photo_public_id")
  preparationTime            Int      @default(15) @map("preparation_time")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([postalCode])
  @@map("seller_profiles")
}

model SellerDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  sellerId           String             @map("seller_id") @db.Uuid
  documentType       String             @map("document_type")
  documentUrl        String             @map("document_url")
  cloudinaryPublicId String?            @map("cloudinary_public_id")
  originalFilename   String?            @map("original_filename")
  mimeType           String?            @map("mime_type")
  fileSize           Int?               @map("file_size")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at")
  rejectionReason    String?            @map("rejection_reason")
  expiryDate         DateTime?          @map("expiry_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  seller  Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviews SellerDocumentReview[]

  @@index([sellerId])
  @@map("seller_documents")
}

model SellerDocumentReview {
  id         String             @id @default(uuid()) @db.Uuid
  documentId String             @map("document_id") @db.Uuid
  reviewerId String             @map("reviewer_id") @db.Uuid
  status     VerificationStatus
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at")

  document SellerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer User           @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([reviewerId])
  @@map("seller_document_reviews")
}

model SellerStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  sellerId   String       @map("seller_id") @db.Uuid
  fromStatus SellerStatus @map("from_status")
  toStatus   SellerStatus @map("to_status")
  reason     String?
  changedBy  String?      @map("changed_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_status_history")
}

model SellerBusinessHours {
  id          String  @id @default(uuid()) @db.Uuid
  sellerId    String  @map("seller_id") @db.Uuid
  dayOfWeek   Int     @map("day_of_week") // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openingTime String  @map("opening_time")
  closingTime String  @map("closing_time")
  isClosed    Boolean @default(false) @map("is_closed")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, dayOfWeek])
  @@map("seller_business_hours")
}

model SellerServiceArea {
  id         String   @id @default(uuid()) @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  postalCode String   @map("postal_code")
  radiusKm   Decimal? @map("radius_km") @db.Decimal(5, 2)
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([postalCode])
  @@index([sellerId, postalCode])
  @@map("seller_service_areas")
}

// ==============================================================================
// 6. MASTER PRODUCT CATALOG & BRANDS
// ==============================================================================

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  iconUrl        String?  @map("icon_url")
  iconPublicId   String?  @map("icon_public_id")
  imageUrl       String?  @map("image_url")
  imagePublicId  String?  @map("image_public_id")
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  taxCode        String?  @map("tax_code")
  defaultGstRate Decimal? @map("default_gst_rate") @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent          Category?        @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryToCategory")
  products        Product[]
  commissionRules CommissionRule[]

  @@index([parentId])
  @@index([slug])
  @@index([displayOrder])
  @@map("categories")
}

model Brand {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  slug         String   @unique
  logoUrl      String?  @map("logo_url")
  logoPublicId String?  @map("logo_public_id")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id                  String         @id @default(uuid()) @db.Uuid
  categoryId          String         @map("category_id") @db.Uuid
  brandId             String?        @map("brand_id") @db.Uuid
  name                String
  slug                String         @unique
  shortDescription    String?        @map("short_description")
  description         String?
  brand               String?
  sku                 String?        @unique
  foodPreference      FoodPreference @default(NA) @map("food_preference")
  countryOfOrigin     String?        @default("India") @map("country_of_origin")
  manufacturerDetails String?        @map("manufacturer_details")
  packerDetails       String?        @map("packer_details")
  shelfLife           String?        @map("shelf_life")
  storageInstructions String?        @map("storage_instructions")
  ingredients         String?
  nutritionalInfo     Json?          @map("nutritional_info")
  specifications      Json?
  attributes          Json?
  searchTags          String[]       @default([]) @map("search_tags")
  isFeatured          Boolean        @default(false) @map("is_featured")
  status              ProductStatus  @default(DRAFT)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandRel       Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  sellerProducts SellerProduct[]
  wishlistItems  WishlistItem[]
  reviews        Review[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([foodPreference])
  @@index([isFeatured])
  @@index([name])
  @@map("products")
}

model ProductVariant {
  id                   String   @id @default(uuid()) @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  name                 String
  packSize             String?  @map("pack_size")
  unitValue            Decimal? @map("unit_value") @db.Decimal(10, 2)
  unitType             String?  @map("unit_type")
  mrp                  Decimal  @default(0.00) @map("mrp") @db.Decimal(12, 2)
  sku                  String?  @unique
  barcode              String?
  primaryImageUrl      String?  @map("primary_image_url")
  primaryImagePublicId String?  @map("primary_image_public_id")
  isActive             Boolean  @default(true) @map("is_active")
  displayOrder         Int      @default(0) @map("display_order")
  attributes           Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  sellerProducts SellerProduct[]

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  imageUrl     String   @map("image_url")
  publicId     String?  @map("public_id")
  altText      String?  @map("alt_text")
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model ProductAttributeDefinition {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  name          String
  key           String
  attributeType String   @map("attribute_type")
  isRequired    Boolean  @default(false) @map("is_required")
  options       Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, key])
  @@map("product_attribute_definitions")
}

// ==============================================================================
// 7. STORE LISTINGS & INVENTORY
// ==============================================================================

model SellerProduct {
  id           String              @id @default(uuid()) @db.Uuid
  sellerId     String              @map("seller_id") @db.Uuid
  productId    String              @map("product_id") @db.Uuid
  variantId    String?             @map("variant_id") @db.Uuid
  sellerSku    String?             @map("seller_sku")
  sellingPrice Decimal             @map("selling_price") @db.Decimal(12, 2)
  mrp          Decimal?            @db.Decimal(12, 2)
  status       SellerProductStatus @default(PENDING)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")

  seller     Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([sellerId, productId, variantId])
  @@index([sellerId, status])
  @@index([productId])
  @@map("seller_products")
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  sellerProductId   String   @unique @map("seller_product_id") @db.Uuid
  stockOnHand       Int      @default(0) @map("stock_on_hand")
  availableQuantity Int      @default(0) @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sellerProduct SellerProduct          @relation(fields: [sellerProductId], references: [id], onDelete: Cascade)
  transactions  InventoryTransaction[]
  reservations  StockReservation[]

  @@map("inventories")
}

model InventoryTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  inventoryId    String                   @map("inventory_id") @db.Uuid
  type           InventoryTransactionType
  quantity       Int
  stockBefore    Int                      @default(0) @map("stock_before")
  stockAfter     Int                      @default(0) @map("stock_after")
  referenceType  String?                  @map("reference_type")
  referenceId    String?                  @map("reference_id")
  note           String?
  idempotencyKey String?                  @map("idempotency_key")
  createdBy      String?                  @map("created_by") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([idempotencyKey])
  @@map("inventory_transactions")
}

model StockReservation {
  id                String                 @id @default(uuid()) @db.Uuid
  inventoryId       String                 @map("inventory_id") @db.Uuid
  orderItemId       String?                @map("order_item_id") @db.Uuid
  cartId            String?                @map("cart_id") @db.Uuid
  checkoutSessionId String?                @map("checkout_session_id")
  unitPrice         Decimal?               @map("unit_price") @db.Decimal(12, 2)
  quantity          Int
  status            StockReservationStatus @default(ACTIVE)
  idempotencyKey    String?                @map("idempotency_key")
  expiresAt         DateTime               @map("expires_at")
  committedAt       DateTime?              @map("committed_at")
  releasedAt        DateTime?              @map("released_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, status])
  @@index([expiresAt])
  @@index([checkoutSessionId])
  @@index([idempotencyKey])
  @@map("stock_reservations")
}

// ==============================================================================
// 8. SHOPPING CART (SINGLE-STORE BOUNDARY)
// ==============================================================================

model Cart {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  sellerId          String?  @map("seller_id") @db.Uuid
  appliedCouponCode String?  @map("applied_coupon_code")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller           Seller?           @relation("SellerCarts", fields: [sellerId], references: [id], onDelete: SetNull)
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([userId])
  @@map("carts")
}

model CheckoutSession {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  cartId          String                @map("cart_id") @db.Uuid
  sellerId        String                @map("seller_id") @db.Uuid
  addressId       String                @map("address_id") @db.Uuid
  addressSnapshot Json                  @map("address_snapshot")
  couponId        String?               @map("coupon_id") @db.Uuid
  couponCode      String?               @map("coupon_code")
  status          CheckoutSessionStatus @default(RESERVATION_ACTIVE)
  itemSubtotal    Decimal               @map("item_subtotal") @db.Decimal(12, 2)
  productDiscount Decimal               @default(0) @map("product_discount") @db.Decimal(12, 2)
  couponDiscount  Decimal               @default(0) @map("coupon_discount") @db.Decimal(12, 2)
  deliveryFee     Decimal               @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  taxAmount       Decimal               @default(0) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal      Decimal               @map("grand_total") @db.Decimal(12, 2)
  distanceKm      Decimal?              @map("distance_km") @db.Decimal(6, 2)
  itemsSnapshot   Json                  @map("items_snapshot")
  idempotencyKey  String?               @map("idempotency_key")
  expiresAt       DateTime              @map("expires_at")
  committedAt     DateTime?             @map("committed_at")
  releasedAt      DateTime?             @map("released_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  user    User            @relation("CustomerCheckoutSessions", fields: [userId], references: [id], onDelete: Cascade)
  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  seller  Seller          @relation("SellerCheckoutSessions", fields: [sellerId], references: [id], onDelete: Restrict)
  address CustomerAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)
  coupon  Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([expiresAt])
  @@index([sellerId])
  @@index([idempotencyKey])
  @@map("checkout_sessions")
}

model CartItem {
  id              String   @id @default(uuid()) @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  sellerProductId String   @map("seller_product_id") @db.Uuid
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cart          Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sellerProduct SellerProduct @relation(fields: [sellerProductId], references: [id], onDelete: Cascade)

  @@unique([cartId, sellerProductId])
  @@map("cart_items")
}

// ==============================================================================
// 9. ORDERS (SINGLE-STORE CHECKOUT)
// ==============================================================================

model Order {
  id                 String         @id @default(uuid()) @db.Uuid
  orderNumber        String         @unique @map("order_number")
  checkoutSessionId  String?        @unique @map("checkout_session_id") @db.Uuid
  idempotencyKey     String?        @unique @map("idempotency_key")
  customerId         String         @map("customer_id") @db.Uuid
  sellerId           String         @map("seller_id") @db.Uuid
  storeNameSnapshot  String?        @map("store_name_snapshot")
  addressSnapshot    Json           @map("address_snapshot")
  couponId           String?        @map("coupon_id") @db.Uuid
  couponCode         String?        @map("coupon_code")
  subtotal           Decimal        @db.Decimal(12, 2)
  deliveryFee        Decimal        @map("delivery_fee") @db.Decimal(12, 2)
  discountAmount     Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount          Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal        @map("total_amount") @db.Decimal(12, 2)
  status             OrderStatus    @default(PENDING)
  paymentMethod      PaymentMethod  @default(COD) @map("payment_method")
  paymentStatus      PaymentStatus  @default(PENDING) @map("payment_status")
  deliveryStatus     DeliveryStatus @default(PENDING) @map("delivery_status")
  notes              String?
  cancellationReason String?        @map("cancellation_reason")
  rejectionReason    String?        @map("rejection_reason")
  cancelledBy        String?        @map("cancelled_by") @db.Uuid
  confirmedAt        DateTime?      @map("confirmed_at")
  packedAt           DateTime?      @map("packed_at")
  dispatchedAt       DateTime?      @map("dispatched_at")
  deliveredAt        DateTime?      @map("delivered_at")
  cancelledAt        DateTime?      @map("cancelled_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  customer         User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  seller           Seller               @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  complaints       OrderComplaint[]
  payments         Payment[]
  refunds          Refund[]
  delivery         Delivery?
  commissionRecord CommissionRecord?
  ledgerEntries    SellerLedgerEntry[]
  couponUsages     CouponUsage[]

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  sellerProductId     String   @map("seller_product_id") @db.Uuid
  productIdSnapshot   String?  @map("product_id_snapshot") @db.Uuid
  variantIdSnapshot   String?  @map("variant_id_snapshot") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  brandSnapshot       String?  @map("brand_snapshot")
  variantNameSnapshot String?  @map("variant_name_snapshot")
  skuSnapshot         String?  @map("sku_snapshot")
  imageUrlSnapshot    String?  @map("image_url_snapshot")
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  mrp                 Decimal? @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount           Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  quantity            Int
  totalAmount         Decimal  @map("total_amount") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerProduct SellerProduct    @relation(fields: [sellerProductId], references: [id], onDelete: Restrict)
  reviews       Review[]
  complaints    OrderComplaint[]

  @@index([orderId])
  @@index([sellerProductId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  previousStatus OrderStatus @map("previous_status")
  newStatus      OrderStatus @map("new_status")
  note           String?
  changedBy      String?     @map("changed_by") @db.Uuid
  actorRole      String?     @map("actor_role")
  createdAt      DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

model OrderComplaint {
  id               String                 @id @default(uuid()) @db.Uuid
  orderId          String                 @map("order_id") @db.Uuid
  orderItemId      String?                @map("order_item_id") @db.Uuid
  customerId       String                 @map("customer_id") @db.Uuid
  category         OrderComplaintCategory
  status           OrderComplaintStatus   @default(OPEN)
  description      String
  evidenceUrls     Json?                  @map("evidence_urls")
  evidencePublicIds Json?                 @map("evidence_public_ids")
  adminNote        String?                @map("admin_note")
  reviewedBy       String?                @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?              @map("reviewed_at")
  resolvedAt       DateTime?              @map("resolved_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customer  User       @relation("CustomerOrderComplaints", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("order_complaints")
}

// ==============================================================================
// 10. PAYMENTS DOMAIN
// ==============================================================================

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  checkoutSessionId String?       @map("checkout_session_id") @db.Uuid
  attemptNumber     Int           @default(1) @map("attempt_number")
  idempotencyKey    String?       @unique @map("idempotency_key")
  provider          String        @default("RAZORPAY")
  paymentMethod     PaymentMethod @default(RAZORPAY) @map("payment_method")
  method            String
  providerOrderId   String?       @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  receipt           String?
  amount            Decimal       @db.Decimal(12, 2)
  capturedAmount    Decimal       @default(0) @map("captured_amount") @db.Decimal(12, 2)
  refundedAmount    Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  gatewayStatus     String?       @map("gateway_status")
  failureCode       String?       @map("failure_code")
  failureReason     String?       @map("failure_reason")
  authorizedAt      DateTime?     @map("authorized_at")
  capturedAt        DateTime?     @map("captured_at")
  failedAt          DateTime?     @map("failed_at")
  paidAt            DateTime?     @map("paid_at")
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order              Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions       PaymentTransaction[]
  statusHistory      PaymentStatusHistory[]
  refunds            Refund[]
  reconciliationLogs PaymentReconciliationLog[]

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([checkoutSessionId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

model PaymentStatusHistory {
  id                String        @id @default(uuid()) @db.Uuid
  paymentId         String        @map("payment_id") @db.Uuid
  previousStatus    PaymentStatus @map("previous_status")
  newStatus         PaymentStatus @map("new_status")
  source            String
  providerEventId   String?       @map("provider_event_id")
  providerPaymentId String?       @map("provider_payment_id")
  note              String?
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_status_histories")
}

model PaymentTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  paymentId             String   @map("payment_id") @db.Uuid
  providerTransactionId String?  @map("provider_transaction_id")
  eventType             String   @map("event_type")
  amount                Decimal  @db.Decimal(12, 2)
  status                String
  providerPayload       Json?    @map("provider_payload")
  processedAt           DateTime @default(now()) @map("processed_at")
  createdAt             DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([providerTransactionId])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @default("RAZORPAY")
  eventId           String    @map("event_id")
  eventType         String    @map("event_type")
  payload           Json
  status            String    @default("RECEIVED")
  signatureVerified Boolean   @default(true) @map("signature_verified")
  retryCount        Int       @default(0) @map("retry_count")
  errorMessage      String?   @map("error_message")
  receivedAt        DateTime  @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

// ==============================================================================
// 11. REFUNDS DOMAIN
// ==============================================================================

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  refundNumber     String       @unique @map("refund_number")
  idempotencyKey   String?      @unique @map("idempotency_key")
  amount           Decimal      @db.Decimal(12, 2)
  reason           String
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique @map("provider_refund_id")
  speedRequested   String?      @default("normal") @map("speed_requested")
  speedProcessed   String?      @map("speed_processed")
  gatewayStatus    String?      @map("gateway_status")
  failureReason    String?      @map("failure_reason")
  requestedBy      String       @map("requested_by") @db.Uuid
  approvedBy       String?      @map("approved_by") @db.Uuid
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment      Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transactions RefundTransaction[]

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model PaymentReconciliationLog {
  id                  String        @id @default(uuid()) @db.Uuid
  paymentId           String        @map("payment_id") @db.Uuid
  orderId             String        @map("order_id") @db.Uuid
  actorId             String?       @map("actor_id") @db.Uuid
  source              String
  previousStatus      PaymentStatus @map("previous_status")
  newStatus           PaymentStatus @map("new_status")
  gatewayStatus       String?       @map("gateway_status")
  expectedAmount      Decimal       @map("expected_amount") @db.Decimal(12, 2)
  gatewayAmount       Decimal?      @map("gateway_amount") @db.Decimal(12, 2)
  discrepancyDetected Boolean       @default(false) @map("discrepancy_detected")
  discrepancyReason   String?       @map("discrepancy_reason")
  resolutionAction    String?       @map("resolution_action")
  createdAt           DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([orderId])
  @@index([discrepancyDetected])
  @@map("payment_reconciliation_logs")
}

model RefundTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  refundId              String   @map("refund_id") @db.Uuid
  providerTransactionId String?  @map("provider_transaction_id")
  amount                Decimal  @db.Decimal(12, 2)
  status                String
  providerPayload       Json?    @map("provider_payload")
  processedAt           DateTime @default(now()) @map("processed_at")
  createdAt             DateTime @default(now()) @map("created_at")

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@map("refund_transactions")
}

// ==============================================================================
// 12. COMMISSION & SELLER FINANCIAL LEDGER
// ==============================================================================

model CommissionRule {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  commissionType CommissionType @default(PERCENTAGE) @map("commission_type")
  commissionRate Decimal        @map("commission_rate") @db.Decimal(5, 2)
  categoryId     String?        @map("category_id") @db.Uuid
  sellerId       String?        @map("seller_id") @db.Uuid
  isActive       Boolean        @default(true) @map("is_active")
  effectiveFrom  DateTime       @default(now()) @map("effective_from")
  effectiveUntil DateTime?      @map("effective_until")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seller            Seller?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  commissionRecords CommissionRecord[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([isActive])
  @@map("commission_rules")
}

model CommissionRecord {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @unique @map("order_id") @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  commissionRuleId String?  @map("commission_rule_id") @db.Uuid
  grossItemAmount  Decimal  @map("gross_item_amount") @db.Decimal(12, 2)
  commissionRate   Decimal  @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(12, 2)
  taxOnCommission  Decimal  @default(0) @map("tax_on_commission") @db.Decimal(12, 2)
  netSellerPayable Decimal  @map("net_seller_payable") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  commissionRule CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@map("commission_records")
}

model SellerLedgerEntry {
  id           String          @id @default(uuid()) @db.Uuid
  sellerId     String          @map("seller_id") @db.Uuid
  orderId      String?         @map("order_id") @db.Uuid
  entryType    LedgerEntryType @map("entry_type")
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(12, 2)
  description  String
  referenceId  String?         @map("reference_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  settlementItems SettlementItem[]

  @@index([sellerId, createdAt])
  @@index([entryType])
  @@map("seller_ledger_entries")
}

// ==============================================================================
// 13. SETTLEMENTS (BATCH PAYOUTS)
// ==============================================================================

model Settlement {
  id               String           @id @default(uuid()) @db.Uuid
  settlementNumber String           @unique @map("settlement_number")
  sellerId         String           @map("seller_id") @db.Uuid
  grossAmount      Decimal          @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(12, 2)
  refundDeductions Decimal          @default(0) @map("refund_deductions") @db.Decimal(12, 2)
  otherAdjustments Decimal          @default(0) @map("other_adjustments") @db.Decimal(12, 2)
  netAmount        Decimal          @map("net_amount") @db.Decimal(12, 2)
  status           SettlementStatus @default(PENDING)
  holdReason       String?          @map("hold_reason")
  payoutMethod     String?          @map("payout_method")
  utrNumber        String?          @map("utr_number")
  periodStart      DateTime         @map("period_start")
  periodEnd        DateTime         @map("period_end")
  initiatedAt      DateTime?        @map("initiated_at")
  completedAt      DateTime?        @map("completed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  seller Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items  SettlementItem[]

  @@index([sellerId, status])
  @@index([createdAt])
  @@map("settlements")
}

model SettlementItem {
  id                  String   @id @default(uuid()) @db.Uuid
  settlementId        String   @map("settlement_id") @db.Uuid
  sellerLedgerEntryId String   @unique @map("seller_ledger_entry_id") @db.Uuid
  amount              Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  settlement  Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  ledgerEntry SellerLedgerEntry @relation(fields: [sellerLedgerEntryId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("settlement_items")
}

// ==============================================================================
// 14. DELIVERY DOMAIN
// ==============================================================================

model DeliveryPartner {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  vehicleType        String             @map("vehicle_type")
  vehicleNumber      String?            @map("vehicle_number")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  availabilityStatus String             @default("OFFLINE") @map("availability_status")
  currentLatitude    Decimal?           @map("current_latitude") @db.Decimal(10, 8)
  currentLongitude   Decimal?           @map("current_longitude") @db.Decimal(11, 8)
  rating             Decimal            @default(5.00) @db.Decimal(3, 2)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries  Delivery[]
  assignments DeliveryAssignment[]

  @@index([availabilityStatus])
  @@map("delivery_partners")
}

model Delivery {
  id                      String         @id @default(uuid()) @db.Uuid
  orderId                 String         @unique @map("order_id") @db.Uuid
  deliveryPartnerId       String?        @map("delivery_partner_id") @db.Uuid
  status                  DeliveryStatus @default(PENDING)
  pickupAddressSnapshot   Json           @map("pickup_address_snapshot")
  deliveryAddressSnapshot Json           @map("delivery_address_snapshot")
  deliveryInstructions    String?        @map("delivery_instructions")
  attemptCount            Int            @default(0) @map("attempt_count")
  maxAttempts             Int            @default(3) @map("max_attempts")
  estimatedDeliveryAt     DateTime?      @map("estimated_delivery_at")
  readyForPickupAt        DateTime?      @map("ready_for_pickup_at")
  assignedAt              DateTime?      @map("assigned_at")
  acceptedAt              DateTime?      @map("accepted_at")
  pickedUpAt              DateTime?      @map("picked_up_at")
  deliveredAt             DateTime?      @map("delivered_at")
  failedAt                DateTime?      @map("failed_at")
  cancelledAt             DateTime?      @map("cancelled_at")
  failureReason           String?        @map("failure_reason")
  cancellationReason      String?        @map("cancellation_reason")
  proofOfDeliveryOtp      String?        @map("proof_of_delivery_otp")
  otpHash                 String?        @map("otp_hash")
  otpExpiresAt            DateTime?      @map("otp_expires_at")
  otpAttempts             Int            @default(0) @map("otp_attempts")
  codCollected            Boolean        @default(false) @map("cod_collected")
  codCollectedAmount      Decimal?       @map("cod_collected_amount") @db.Decimal(12, 2)
  recipientName           String?        @map("recipient_name")
  deliveryNotes           String?        @map("delivery_notes")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryPartner DeliveryPartner?        @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  assignments     DeliveryAssignment[]
  statusHistory   DeliveryStatusHistory[]

  @@index([deliveryPartnerId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryAssignment {
  id                String                   @id @default(uuid()) @db.Uuid
  deliveryId        String                   @map("delivery_id") @db.Uuid
  deliveryPartnerId String                   @map("delivery_partner_id") @db.Uuid
  status            DeliveryAssignmentStatus @default(OFFERED)
  rejectionReason   String?                  @map("rejection_reason")
  assignedBy        String?                  @map("assigned_by") @db.Uuid
  expiresAt         DateTime?                @map("expires_at")
  assignedAt        DateTime                 @default(now()) @map("assigned_at")
  respondedAt       DateTime?                @map("responded_at")
  createdAt         DateTime                 @default(now()) @map("created_at")

  delivery        Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@map("delivery_assignments")
}

model DeliveryStatusHistory {
  id             String         @id @default(uuid()) @db.Uuid
  deliveryId     String         @map("delivery_id") @db.Uuid
  previousStatus DeliveryStatus @map("previous_status")
  newStatus      DeliveryStatus @map("new_status")
  actorRole      String?        @map("actor_role")
  note           String?
  updatedBy      String?        @map("updated_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("delivery_status_histories")
}

// ==============================================================================
// 15. MARKETING DOMAIN (COUPONS & BANNERS)
// ==============================================================================

model Coupon {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique
  description        String?
  discountType       DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue      Decimal      @map("discount_value") @db.Decimal(12, 2)
  minimumOrderAmount Decimal      @default(0) @map("minimum_order_amount") @db.Decimal(12, 2)
  maximumDiscount    Decimal?     @map("maximum_discount") @db.Decimal(12, 2)
  usageLimit         Int?         @map("usage_limit")
  perUserLimit       Int          @default(1) @map("per_user_limit")
  startsAt           DateTime     @map("starts_at")
  expiresAt          DateTime     @map("expires_at")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  usages           CouponUsage[]
  checkoutSessions CheckoutSession[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  usedAt         DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

model Banner {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  imageUrl     String    @map("image_url")
  targetUrl    String?   @map("target_url")
  placement    String    @default("HOME_TOP")
  displayOrder Int       @default(0) @map("display_order")
  startsAt     DateTime  @default(now()) @map("starts_at")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([placement, isActive])
  @@map("banners")
}

// ==============================================================================
// 16. ENGAGEMENT DOMAIN (REVIEWS & WISHLISTS)
// ==============================================================================

model Review {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  sellerId           String?  @map("seller_id") @db.Uuid
  sellerProductId    String?  @map("seller_product_id") @db.Uuid
  orderItemId        String?  @map("order_item_id") @db.Uuid
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean  @default(true) @map("is_verified_purchase")
  isPublished        Boolean  @default(true) @map("is_published")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, rating])
  @@index([userId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==============================================================================
// 17. NOTIFICATIONS DOMAIN
// ==============================================================================

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  metadata  Json?
  isRead    Boolean             @default(false) @map("is_read")
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime            @default(now()) @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  isEnabled Boolean             @default(true) @map("is_enabled")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

// ==============================================================================
// 18. ADMINISTRATION & AUDIT LOGS
// ==============================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  module      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation("AdminLogs", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([module])
  @@map("admin_activity_logs")
}

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
