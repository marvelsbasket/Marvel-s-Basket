# ==============================================================================
# MARVEL'S BASKET — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit actual credentials or secret keys to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=marvel
POSTGRES_PASSWORD=marvel_dev_secure_password_2026
POSTGRES_DB=marvels_basket_dev
POSTGRES_PORT=5433
DATABASE_URL="postgresql://marvel:marvel_dev_secure_password_2026@localhost:5433/marvels_basket_dev?schema=public"

# ------------------------------------------------------------------------------
# Redis Cache & Queue
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6380"

# ------------------------------------------------------------------------------
# Backend API Service (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=super_secret_jwt_key_for_development_minimum_32_characters_long
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=super_secret_jwt_access_key_development_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_development_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Email Delivery (Resend) & Verification OTP (Phase 04)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_dev_placeholder_api_key
EMAIL_FROM="Marvel's Basket <noreply@marvelsbasket.com>"
EMAIL_VERIFICATION_OTP_LENGTH=6
EMAIL_VERIFICATION_OTP_TTL_SECONDS=300
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=900

# Email OTP & Development Terminal Visibility
EMAIL_OTP_ENABLED=true
DEV_LOG_EMAIL_OTP=true
DEV_SEND_REAL_EMAILS=false

# ------------------------------------------------------------------------------
# Frontend Web Service (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Marvel's Basket"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_PORT=3000

# ------------------------------------------------------------------------------
# Third-Party Integrations (Placeholders for Future Implementation Phases)
# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Phase 13)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_CAPTURE_MODE=automatic
COD_MAX_AMOUNT=1500

# Delivery Provider (Phase 09)
DELIVERY_PROVIDER=internal

# ------------------------------------------------------------------------------
# Cloudinary Storage & Media Management (Phase 07)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Sensitive Data Encryption (Phase 07)
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=marvels-basket-aes256-default-key-32b!
