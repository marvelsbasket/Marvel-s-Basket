{
  "name": "marvels-basket",
  "version": "1.0.0",
  "private": true,
  "description": "Production monorepo for Marvel's Basket - Hyperlocal Grocery & Essentials Marketplace",
  "author": "Marvel's Techworks",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"blue,green\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:debug": "concurrently -n \"web,api\" -c \"blue,green\" \"npm run dev:web:debug\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@marvels-basket/web",
    "dev:web:debug": "npm run dev:debug --workspace=@marvels-basket/web",
    "dev:api": "npm run dev --workspace=@marvels-basket/api",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "npm run build --workspace=@marvels-basket/shared",
    "build:web": "npm run build --workspace=@marvels-basket/web",
    "build:api": "npm run build --workspace=@marvels-basket/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace=@marvels-basket/shared && npm run typecheck --workspace=@marvels-basket/api && npm run typecheck --workspace=@marvels-basket/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=@marvels-basket/api",
    "test:api:e2e": "npm run test:e2e --workspace=@marvels-basket/api",
    "clean": "node scripts/development/clean.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "db:generate": "npm run db:generate --workspace=@marvels-basket/api",
    "db:validate": "npm run db:validate --workspace=@marvels-basket/api",
    "db:format": "npm run db:format --workspace=@marvels-basket/api",
    "db:migrate": "npm run db:migrate --workspace=@marvels-basket/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@marvels-basket/api",
    "db:seed": "npm run db:seed --workspace=@marvels-basket/api",
    "db:studio": "npm run db:studio --workspace=@marvels-basket/api",
    "db:status": "npm run db:status --workspace=@marvels-basket/api",
    "db:test": "npm run test:db --workspace=@marvels-basket/api",
    "docker:up": "node scripts/docker/manage.js up",
    "docker:down": "node scripts/docker/manage.js down",
    "docker:restart": "node scripts/docker/manage.js restart",
    "docker:ps": "node scripts/docker/manage.js ps",
    "docker:logs": "node scripts/docker/manage.js logs",
    "docker:logs:db": "node scripts/docker/manage.js logs postgres",
    "docker:logs:redis": "node scripts/docker/manage.js logs redis",
    "docker:build": "node scripts/docker/manage.js build",
    "docker:pull": "node scripts/docker/manage.js pull",
    "docker:config": "node scripts/docker/manage.js config",
    "docker:health": "node scripts/docker/manage.js health",
    "docker:reset": "node scripts/docker/manage.js reset",
    "docker:clean": "node scripts/docker/manage.js clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
